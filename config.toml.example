# blabble config — copied to ~/.config/blabble/config.toml on first install

[server]
url = "http://localhost:8080"
connect_timeout = 3.0           # seconds before giving up on an unreachable backend
read_timeout = 60.0             # seconds to wait for transcription response
retries = 1                     # extra attempts on transient errors (connect/read timeout, HTTP 5xx); 0 disables

[recording]
device = "pulse"
sample_rate = 16000
keep_local_copies = false       # if true, save WAVs to ~/.local/share/blabble/recordings/
max_local_copies = 50
silence_rms_threshold = 200.0   # skip transcription if WAV's RMS energy is below this (whisper hallucinates on silence)
min_duration_ms = 250           # skip transcription for recordings shorter than this (accidental hotkey taps)
max_duration_sec = 300          # auto-stop after this many seconds (safety net for forgotten toggles); 0 disables
# Hallucination filter: drop transcriptions whose final text matches any of these regexes.
# Whisper.cpp hallucinates on near-silent input; these are the common training-data ghosts.
discard_if_matches = [
    '^\s*\*[^*]+\*\s*$',            # *punch*, *cough*, *music*
    '^\s*\[[^\]]+\]\s*$',           # [BLANK_AUDIO], [Music], [silence]
    '^\s*\(\s*[^)]*\s*\)\s*$',      # ( ), (silence)
    '^\s*Thanks?\s+for\s+watching.*$',
    '^\s*Thank\s+you\.?\s*$',
    '^\s*you\.?\s*$',
    '^\s*\.?\s*$',                  # bare period or empty
]

[hotkey]
toggle = "Meta+Space"           # initial preferred trigger; rebind anytime in System Settings → Shortcuts → "blabble"

[sounds]
enabled = true
start = "auto"                  # "auto" = generated upward blip; or absolute path to a .wav
stop  = "auto"                  # "auto" = generated downward blip
volume = 0.5                    # 0.0 = silent, 1.0 = file's baked-in level (~15% amplitude); applied via paplay --volume

[paste]
method = "clipboard"            # "clipboard" (wl-copy + ydotool Ctrl+Shift+V — fastest, replaces clipboard)
                                # "ydotool"   (types char-by-char; drops chars at low key-delay on KWin)
                                # "wtype"     (wlroots compositors only)
press_enter_after = false       # if true, send Enter after the paste (saves the keystroke when dictating into chat/prompts)
restore_clipboard = true        # snapshot the clipboard before paste, restore it after, so dictation doesn't wipe what you copied
restore_delay_ms = 400          # how long to wait after the paste chord before restoring (target app must consume the paste first)

[tray]
enabled = true
icon_idle = "audio-input-microphone"
icon_recording = "media-record"
icon_error = "dialog-warning"   # shown briefly when transcription fails (Linux freedesktop icon name; Windows uses a built-in amber dot)

# Transformations run in order on the transcribed text before paste.
# Glue contractions back together when whisper.cpp wraps a segment between the
# stem and its apostrophe-suffix (e.g. "don\n't" → "don 't" without this rule).
# Must run BEFORE strip-newlines so the lookahead still sees the apostrophe.
[[transformations]]
name = "glue contractions"
find = "\\s*\\n+\\s*(?='[a-zA-Z])"
replace = ""
regex = true

# Strip whisper.cpp's per-segment newlines (the contraction-split fix).
[[transformations]]
name = "strip newlines"
find = '\s*\n+\s*'
replace = " "
regex = true

# When you say "period" to end a sentence, whisper writes "period." — collapse
# that to just "." Runs after strip-newlines so the space before is normalized.
# Caveat: also rewrites legit phrases like "time period." → "time." Rare enough
# in dictation to be worth the tradeoff; remove this rule if it bites you.
[[transformations]]
name = "spoken period"
find = '\s+[Pp]eriod\.'
replace = "."
regex = true
